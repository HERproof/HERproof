# Copy to .env (setup/install.sh writes this for you).
PHONE_REMOTE_URL=http://127.0.0.1:44321
PHONE_REMOTE_TOKEN=            # daemon password; printed by the iphone-use installer, also in ~/Library/LaunchAgents/com.leeguoo.iphone-use.plist
PHONE_REMOTE_OWNER=herproof    # any name; must not collide with a running MCP session
WDA_TEAM_ID=                   # 10-char Apple Team ID (the OU in your Apple Development certificate)
WDA_UDID=                      # classic UDID from `idevice_id -l`
PHONE_REMOTE_UDID=
# Classifier: set one (or both) and pick with HERPROOF_PROVIDER / --provider
ANTHROPIC_API_KEY=             # Claude; or run `ant auth login`
GEMINI_API_KEY=                # Gemini (Google AI Studio key)
HERPROOF_PROVIDER=auto         # auto | claude | gemini
# ANTHROPIC_MODEL=claude-opus-5
# GEMINI_MODEL=gemini-2.5-pro
HERPROOF_DEVICE=               # optional label for the JSON, e.g. "Ava (iPhone 17)"
